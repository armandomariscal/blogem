<div class="max-w-2xl mx-auto mt-4 space-y-8">
  
  <%# Encabezado y Acciones %>
  <div class="border-b pb-6">
    <%= link_to "← Volver a artículos", articles_path, class: "text-sm text-blue-600 hover:underline font-medium inline-block mb-4" %>
    
    <h1 class="text-4xl font-extrabold text-gray-950 tracking-tight mb-4">
      <%= @article.title %>
    </h1>

    <div class="flex space-x-3">
      <%= link_to "Editar", edit_article_path(@article), 
            class: "bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold px-4 py-2 rounded-lg text-sm transition shadow-sm" %>
            
      <%= link_to "Eliminar", article_path(@article), 
            data: { turbo_method: :delete, turbo_confirm: "¿Estás seguro?" }, 
            class: "bg-red-50 hover:bg-red-100 text-red-600 font-semibold px-4 py-2 rounded-lg text-sm transition border border-red-200" %>
    </div>
  </div>

  <%# Cuerpo del Artículo %>
  <div class="prose max-w-none text-gray-800 text-lg leading-relaxed whitespace-pre-line">
    <%= @article.body %>
  </div>

  <%# Sección de Comentarios %>
  <div class="border-t pt-6 space-y-4">
    <h2 class="text-2xl font-bold text-gray-900 tracking-tight">Comentarios</h2>
    
    <div class="bg-gray-50 rounded-xl p-4 divide-y divide-gray-200">
      <%= render @article.comments %>
    </div>
  </div>

  <%# Formulario para nuevo comentario %>
  <div class="border-t pt-6">
    <h2 class="text-xl font-bold text-gray-900 tracking-tight mb-4">Agregar un comentario</h2>
    <div class="bg-white p-5 rounded-xl border border-gray-200 shadow-sm">
      <%= render "comments/form", article: @article %>
    </div>
  </div>

</div>